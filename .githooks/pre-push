#!/usr/bin/env bash
# Local CI gate — runs the same checks as .github/workflows/checks.yml before a push,
# so lint/test/codegen failures surface in ~1 minute instead of a ~6 minute CI round-trip.
#
# Enable:  git config core.hooksPath .githooks
# Disable: git config --unset core.hooksPath
# Bypass once: git push --no-verify
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# The webui half (npm ci, karma, dist rebuild) is slow, so only run it when the
# push actually touches webui or the GraphQL schema/operations it generates from.
changed=$(git diff --name-only origin/main...HEAD 2>/dev/null || true)

tasks=(check)
if grep -qE '^(webui|graphql)/' <<<"${changed}"; then
  tasks+=(check-webui)
fi

echo "pre-push: task ${tasks[*]}  (bypass with: git push --no-verify)"
# Same hermetic flags CI uses — without them a system Go leaks in and clashes
# with the pinned toolchain. `git` is in the devshell for the diff check.
exec nix develop --ignore-environment --keep HOME . --command task "${tasks[@]}"
