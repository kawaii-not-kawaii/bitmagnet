enum LlmClassificationOutcome {
  MATCHED
  UNMATCHED
  ERROR
  SKIPPED
}

type LlmClassificationEvent {
  timestamp: DateTime!
  infoHash: String!
  torrentName: String!
  provider: String!
  durationMs: Int!
  outcome: LlmClassificationOutcome!
  promptTokens: Int!
  completionTokens: Int!
  contentType: String!
  title: String!
  year: Int!
  season: Int!
  episode: Int!
  languages: [String!]!
  error: String!
}

type LlmProviderStats {
  provider: String!
  attempted: Int!
  matched: Int!
  unmatched: Int!
  errored: Int!
}

type LlmErrorCategoryStats {
  category: String!
  count: Int!
}

type LlmStats {
  attempted: Int!
  matched: Int!
  unmatched: Int!
  errored: Int!
  skipped: Int!
  promptTokens: Int!
  completionTokens: Int!
  successRate: Float!
  perProvider: [LlmProviderStats!]!
  errorCategories: [LlmErrorCategoryStats!]!
  inFlight: Int!
  # The configured ceiling.
  concurrency: Int!
  # The controller's current admission limit; equals the ceiling while
  # auto-scaling is disabled.
  effectiveConcurrency: Int!
  windowStart: DateTime!
  oldestBuffered: DateTime
  windowAttempted: Int!
  latencyP50Ms: Int!
  latencyP95Ms: Int!
  throughputPerMinute: Float!
  queuePending: Int!
}

type LlmQuery {
  events(limit: Int): [LlmClassificationEvent!]!
  stats(windowMinutes: Int): LlmStats!
}
